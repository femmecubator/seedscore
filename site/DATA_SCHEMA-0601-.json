{
  "schema": {
    "Project": {
      "type": "object",
      "required": ["id", "name", "llmModel", "createdAt"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (UUID or timestamp-based)"
        },
        "name": {
          "type": "string",
          "description": "Project name"
        },
        "description": {
          "type": "string",
          "description": "Project description"
        },
        "llmModel": {
          "type": "string",
          "enum": ["Claude 3.5 Sonnet", "GPT-4", "GPT-4 Turbo", "Claude 3 Opus", "Gemini Pro", "Other"]
        },
        "inferenceCalls": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of API calls in assessment period"
        },
        "apiCost": {
          "type": "string",
          "description": "Total API cost (e.g., '$45.50')"
        },
        "teamSize": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of people on the project"
        },
        "projectDurationDays": {
          "type": "integer",
          "minimum": 1,
          "description": "Project duration in days"
        },
        "outcomes": {
          "type": "string",
          "description": "Key outcomes achieved"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Assessment creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Categorization tags (e.g., 'content', 'research', 'customer-facing')"
        },
        "isPublic": {
          "type": "boolean",
          "default": false,
          "description": "Whether to include in public benchmarking"
        }
      }
    },
    "Assessment": {
      "type": "object",
      "required": ["projectId", "responses"],
      "properties": {
        "projectId": {
          "type": "string",
          "description": "Reference to Project"
        },
        "responses": {
          "type": "object",
          "description": "Question ID → Score mapping",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          }
        },
        "notes": {
          "type": "string",
          "description": "Optional qualitative feedback"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ScoreCard": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "human": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Average of H1-H5 scores"
        },
        "systems": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Average of S1-S5 scores"
        },
        "environment": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Average of E1-E3 scores"
        },
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Average of all three pillars"
        },
        "breakdown": {
          "type": "object",
          "description": "Score breakdown by question",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "score": { "type": "integer" },
              "title": { "type": "string" }
            }
          }
        }
      }
    },
    "EnvironmentalMetrics": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "inferenceCalls": {
          "type": "integer"
        },
        "estimatedTokens": {
          "type": "integer",
          "description": "Inferred from call count (typically 1,200 per call)"
        },
        "llmModel": {
          "type": "string"
        },
        "emissionsPerToken": {
          "type": "number",
          "description": "kg CO₂ per token (model-specific)"
        },
        "estimatedCO2Kg": {
          "type": "number",
          "description": "Total CO₂ in kg for the assessment period"
        },
        "humanComparison": {
          "type": "object",
          "properties": {
            "humanHoursEquivalent": {
              "type": "number",
              "description": "Hours of human work that would be needed"
            },
            "humanCO2Kg": {
              "type": "number",
              "description": "CO₂ equivalent of human work (office electricity, commute)"
            },
            "aiVsHumanRatio": {
              "type": "number",
              "description": "How many times more efficient (>1 = AI wins)"
            }
          }
        },
        "assessmentPeriodDays": {
          "type": "integer"
        }
      }
    },
    "Report": {
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "project": { "$ref": "#/definitions/Project" },
        "scoreCard": { "$ref": "#/definitions/ScoreCard" },
        "environmentalMetrics": { "$ref": "#/definitions/EnvironmentalMetrics" },
        "interpretation": {
          "type": "string",
          "description": "Human-readable summary of scores"
        },
        "recommendations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string",
          "default": "1.0"
        }
      }
    }
  },
